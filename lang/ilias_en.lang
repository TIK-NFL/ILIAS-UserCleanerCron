// auth configuration
auth_form_title#:#External check sources
auth_rest_section_title#:#REST check
auth_rest_url_template#:#Status URL
auth_rest_url_template_info#:#URL for the external account check. {login} can be used as placeholder for the ILIAS login.
auth_rest_auth_header#:#HTTP Authorization header
auth_rest_auth_header_info#:#Optional Authorization header, e.g. Bearer TOKEN.
auth_rest_active_json_path#:#JSON path for active state
auth_rest_active_json_path_info#:#Optional dot path in JSON, e.g. active or account.enabled.
auth_rest_active_value#:#Active value
auth_rest_active_value_info#:#Value that means active, e.g. true, 1 or active.
auth_ldap_section_title#:#LDAP check
auth_ldap_status_attribute#:#LDAP status attribute
auth_ldap_status_attribute_info#:#Optional LDAP attribute containing the account status.
auth_ldap_active_value#:#LDAP active value
auth_ldap_active_value_info#:#Value of the status attribute that means active.
auth_rest_connection_test_login#:#Test login
auth_rest_connection_test_login_info#:#Optional login for the REST connection test. Replaces {login} in the status URL.
auth_ldap_host#:#LDAP host
auth_ldap_host_info#:#Host name or IP address of the LDAP server used for the connection test.
auth_ldap_port#:#LDAP port
auth_ldap_port_info#:#Port of the LDAP server. Default is 389.
auth_ldap_bind_dn#:#LDAP bind DN
auth_ldap_bind_dn_info#:#Optional technical user for the connection test. Leave empty for anonymous bind.
auth_ldap_bind_password#:#LDAP bind password
auth_ldap_bind_password_info#:#Optional password for the technical bind user.
auth_connection_test_rest_skipped#:#REST test skipped: no status URL configured.
auth_connection_test_rest_missing_login#:#REST test failed: the status URL contains {login}, but no test login is configured.
auth_connection_test_rest_curl_missing#:#REST test failed: the PHP cURL extension is not available.
auth_connection_test_rest_failed#:#REST test failed: the connection could not be initialized.
auth_connection_test_rest_failed_with_status#:#REST test failed: response status/error %s.
auth_connection_test_rest_success#:#REST test successful: HTTP status %s.
auth_connection_test_ldap_skipped#:#LDAP test skipped: no LDAP host configured.
auth_connection_test_ldap_extension_missing#:#LDAP test failed: the PHP LDAP extension is not available.
auth_connection_test_ldap_failed#:#LDAP test failed: connection or bind was not successful.
auth_connection_test_ldap_success#:#LDAP test successful: connection and bind were successful.
